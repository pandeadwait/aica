# Shared
COMPOSE_PROJECT_NAME=tax-assistant
TZ=Asia/Kolkata

# Frontend
FRONTEND_PORT=3000

# Backend
BACKEND_PORT=8000

# PostgreSQL
POSTGRES_DB=tax_assistant
POSTGRES_USER=tax_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# LLM / Ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_PULL_ON_START=false

# Data paths inside containers
APP_DOCUMENTS_DIR=/app/data/documents
APP_ARTIFACTS_DIR=/app/data/artifacts
APP_TEMP_DIR=/app/data/temp

